# ─────────────────────────────────────────────────────
# OpsPilot — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────

# ─── PostgreSQL ───────────────────────────────────────
POSTGRES_USER=opspilot
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=opspilot

# ─── Application Database URLs ────────────────────────
# Used by the FastAPI app (async driver)
DATABASE_URL=postgresql+asyncpg://opspilot:change_me_in_production@localhost:5432/opspilot
# Used by Alembic migrations (sync driver)
SYNC_DATABASE_URL=postgresql+psycopg2://opspilot:change_me_in_production@localhost:5432/opspilot

# ─── Redis ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Security ─────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_THIS_IN_PRODUCTION_USE_64_RANDOM_CHARS
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── AI / LLM ─────────────────────────────────────────
# Options: mock | openai | anthropic
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── Logging ──────────────────────────────────────────
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ─── Environment ──────────────────────────────────────
# Options: development | staging | production
ENVIRONMENT=development

# ─── CORS ─────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ─── Frontend ─────────────────────────────────────────
VITE_API_URL=http://localhost:8000
